# Server
PORT=8080
APP_ENV=development

# Redis
REDIS_ADDR=localhost:6379
# REDIS_URL=redis://localhost:6379

# PostgreSQL (usa uno de los dos formatos)
# Opción A: URL completa
# POSTGRES_URL=postgres://postgres:postgres@localhost:5432/leaderboard?sslmode=disable

# Opción B: Variables individuales (compatible con docker-compose)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=leaderboard
DB_SSLMODE=disable